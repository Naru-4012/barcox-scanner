# Supabase browser configuration.
# These values identify the public Supabase project and are safe to expose in browser code.
# Never put a Supabase service-role key or database password in VITE_* variables.
# Add the same values in Vercel Project Settings -> Environment Variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
